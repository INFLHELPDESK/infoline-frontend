# Husky hooks run under sh; CRLF would break them on Windows checkouts.
.husky/pre-commit text eol=lf
# Figma references are verified by SHA-256 (tests/visual); keep them byte-exact.
tests/visual/figma/** -text
# Original Figma exports whose bytes the visual specs check against the cache.
public/assets/insights/bg-pattern.svg -text
