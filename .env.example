# WordPress (WPGraphQL) endpoint used by lib/wp. There is NO default: when this
# is unset the CMS client fails closed instead of calling production.
# Production value is set in the hosting environment, never committed here.
NEXT_PUBLIC_WPGRAPHQL_ENDPOINT=http://127.0.0.1:3199/graphql

# Set to 1 for tests, CI and any validation run. The CMS client then refuses to
# talk to the production CMS host even if the endpoint points at it.
CMS_ISOLATED=1

# Optional: Cloudflare Turnstile site key for the contact form.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
